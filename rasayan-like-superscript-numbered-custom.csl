<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Rasayan-like Superscript Numbered (Custom)</title>
    <id>http://www.zotero.org/styles/rasayan-like-superscript-numbered-custom</id>
    <link href="http://www.zotero.org/styles/rasayan-like-superscript-numbered-custom" rel="self"/>
    <author>
      <name>Custom style generated with ChatGPT</name>
    </author>
    <category citation-format="numeric"/>
    <summary>Approximation of the superscript-numbered reference format shown in the user's example. Check against the target journal's current instructions.</summary>
    <updated>2026-10-28T00:00:00+00:00</updated>
  </info>
  <citation collapse="citation-number">
    <layout vertical-align="sup" delimiter="," prefix="[" suffix="]">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <choose>
        <if type="article-journal">
          <group delimiter=", ">
            <names variable="author" delimiter=" and ">
              <name initialize-with="." delimiter=", " and="text"/>
            </names>
            <text variable="container-title" form="short" font-style="italic"/>
            <text variable="volume" font-weight="bold"/>
            <group delimiter=" ">
              <text variable="page"/>
              <date variable="issued" prefix="(" suffix=")">
                <date-part name="year"/>
              </date>
            </group>
          </group>
        </if>
        <else-if type="chapter paper-conference">
          <group delimiter=", ">
            <names variable="author" delimiter=" and ">
              <name initialize-with="." delimiter=", " and="text"/>
            </names>
            <text variable="title" quotes="false"/>
            <group delimiter=" ">
              <text value="in:"/>
              <names variable="editor" delimiter=" and ">
                <name initialize-with="." and="text"/>
                <label form="short" prefix=" (" suffix=")"/>
              </names>
            </group>
            <text variable="container-title" font-style="italic"/>
            <text variable="publisher"/>
            <text variable="publisher-place"/>
            <group delimiter=" ">
              <text value="pp."/>
              <text variable="page"/>
            </group>
            <date variable="issued" prefix="(" suffix=")">
              <date-part name="year"/>
            </date>
          </group>
        </else-if>
        <else-if type="book">
          <group delimiter=", ">
            <names variable="author" delimiter=" and ">
              <name initialize-with="." delimiter=" and " and="text"/>
            </names>
            <text variable="title" font-style="italic"/>
            <text variable="publisher"/>
            <text variable="publisher-place"/>
            <group delimiter="">
              <text value="p."/>
              <text variable="number-of-pages"/>
            </group>
            <date variable="issued" prefix="(" suffix=")">
              <date-part name="year"/>
            </date>
          </group>
        </else-if>
        <else>
          <group delimiter=", ">
            <names variable="author" delimiter=" and ">
              <name initialize-with="." delimiter=", " and="text"/>
            </names>
            <text variable="title" font-style="italic"/>
            <text variable="container-title" font-style="italic"/>
            <text variable="publisher"/>
            <date variable="issued" prefix="(" suffix=")">
              <date-part name="year"/>
            </date>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
